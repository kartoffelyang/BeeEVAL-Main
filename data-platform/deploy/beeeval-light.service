[Unit]
Description=BeeEVAL Light authenticated gateway
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=beeeval-light
Group=beeeval-light
# Replace RELEASE with the concrete release directory during installation.
ExecStart=/usr/bin/node /opt/beeeval-light/releases/RELEASE/server/dist/index.mjs
Environment=PORT=5188
Environment=BEEEVAL_UPSTREAM=https://open.beeeval.com
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
